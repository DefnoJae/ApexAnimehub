{
  "name": "apex-anime-hub",
  "version": "1.0.0",
  "description": "Anime discovery, playback dashboard, dub schedules and watch-progress syncing",
  "main": "src/index.tsx",
  "dependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-modal": "^3.16.3",
    "anime-sdk": "1.1.0",
    "artplayer": "5.4.0",
    "autoprefixer": "^10.4.18",
    "hls.js": "1.5.7",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-modal": "3.16.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "oauth-server": "node server/oauth.cjs",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "test:server": "node --test server/oauth.test.cjs server/vercel.test.cjs server/playback.test.cjs server/artwork.test.cjs server/episodes.test.cjs server/signsync.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DefnoJae/ApexAnimehub.git"
  },
  "proxy": "http://localhost:3001",
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^18.19.0",
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
