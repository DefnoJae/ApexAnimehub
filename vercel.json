{
  "buildCommand": "npm run build",
  "installCommand": "npm ci --legacy-peer-deps",
  "outputDirectory": "build",
  "functions": {
    "api/handler.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
