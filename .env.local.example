# Same-origin account backend (never use REACT_APP_ for secrets)
APP_ORIGIN=http://localhost:3000
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret
ANILIST_REDIRECT_URI=http://localhost:3000/api/oauth/anilist/callback
MAL_CLIENT_ID=your_mal_client_id
MAL_REDIRECT_URI=http://localhost:3000/api/oauth/mal/callback
# Include for a confidential MAL web client; omit for a public client.
MAL_CLIENT_SECRET=
