# MyAnimeList OAuth Credentials
# Get these from: https://myanimelist.net/apiconfig/references/authorization
REACT_APP_MAL_CLIENT_ID=your_mal_client_id
REACT_APP_MAL_REDIRECT_URI=http://localhost:3000/oauth/mal

# AniList OAuth Credentials
# Get these from: https://anilist.co/settings/developer
REACT_APP_ANILIST_CLIENT_ID=your_anilist_client_id
REACT_APP_ANILIST_REDIRECT_URI=http://localhost:3000/oauth/anilist

# Server only (never prefix secrets with REACT_APP_)
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_server_only_secret
ANILIST_REDIRECT_URI=http://localhost:3000/api/oauth/anilist/callback
APP_ORIGIN=http://localhost:3000
